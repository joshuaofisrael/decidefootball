# Copy to .env.local for local overrides. Never commit real secrets.

# RED = kill switch (withhold decision pages; noindex everything)
# YELLOW = hold / noindex unless Joshua + counsel accept residual risk
# GREEN = first-party + approved sources may render; fixture sports pages stay noindex
COMPLIANCE_GATE=GREEN

# Fixture mode is the Phase-1 default. Do not set USE_DATABASE=true until
# licensed ingest is approved and DATABASE_URL points at a real Postgres.
USE_DATABASE=false
USE_FIXTURES=true

# Postgres — required only for prisma migrate / seed / future licensed ingest.
# Local app and `npm run build` work without this.
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/decidefootball"

# Redis / job runner — interfaces are stubbed. Leave unset.
# REDIS_URL=
# JOB_QUEUE_DRIVER=noop

# AI explain is off by default. Never invent stats or injuries.
AI_EXPLAIN_ENABLED=false
# AI_PROVIDER=
# AI_API_KEY=

# Analytics — do not load until visitor accepts the consent stub AND Joshua
# confirms vendors. Leave empty to keep GA4 off.
# NEXT_PUBLIC_GA4_ID=

# Public site URL used in sitemap / canonicals (apex, no trailing slash).
NEXT_PUBLIC_SITE_URL=https://decidefootball.com

# Display timezone for “playing today” copy. Provisional until Joshua confirms.
# NEED JOSHUA INPUT
NEXT_PUBLIC_DISPLAY_TZ=America/New_York

# Default scoring format. Provisional until Joshua confirms. Recommend PPR.
# NEED JOSHUA INPUT
NEXT_PUBLIC_DEFAULT_FORMAT=ppr
